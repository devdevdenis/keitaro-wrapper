# --- Приложение -------------------------------------------------------------
DEBUG=false
# SQLite по умолчанию; для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5432/keitaro_wrapper
DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db
CORS_ORIGINS=["http://localhost:5173"]

# --- Keitaro ----------------------------------------------------------------
# Адрес трекера без /admin_api/v1
KEITARO_URL=https://tracker.example.com
# Ключ: Maintenance → Users → Admin API keys
KEITARO_API_KEY=
KEITARO_TIMEOUT=15

# --- Правила создания кампаний ---------------------------------------------
CAMPAIGN_NAME_PREFIX=test_volper_
GOOGLE_REDIRECT_URL=https://www.google.com
STREAM_REDIRECT_ACTION=http
COUNTRY_FILTER_NAME=country
